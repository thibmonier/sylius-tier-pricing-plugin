{% set form = hookable_metadata.context.form %}
{% set rule = form.vars.value %}
{% if rule.id is not null and rule.scope != 'taxon' and rule.channel is not null %}
    {% include '@TmonierSyliusTierPricingPlugin/admin/shared/masked_taxon_thresholds.html.twig' with { product: rule.targetProduct, channel_code: rule.channel.code } only %}
{% endif %}

<div class="row">
    <div class="col-12 col-md-6">{{ form_row(form.channel) }}</div>
    <div class="col-12 col-md-6">{{ form_row(form.customerGroup) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-3">{{ form_row(form.scope) }}</div>
    <div class="col-12 col-md-3">{{ form_row(form.product) }}</div>
    <div class="col-12 col-md-3">{{ form_row(form.variant) }}</div>
    <div class="col-12 col-md-3">{{ form_row(form.taxon) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.minQuantity) }}</div>
    <div class="col-12 col-md-8">{{ form_row(form.quantityBasis) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.type) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.percentage) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.amount) }}</div>
</div>
<div class="row">
    <div class="col-12">{{ form_row(form.cumulation) }}</div>
</div>
<div class="row">
    <div class="col-12 col-md-4">{{ form_row(form.startsAt) }}</div>
    <div class="col-12 col-md-4">{{ form_row(form.endsAt) }}</div>
    <div class="col-12 col-md-4 pt-md-4">{{ form_row(form.enabled) }}</div>
</div>
<p class="text-secondary small mb-0">{{ 'tmonier_tier_pricing.form.legal_help'|trans }}</p>
