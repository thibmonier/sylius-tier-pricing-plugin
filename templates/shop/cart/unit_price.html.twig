{# Same cell as @SyliusShop/cart/index/content/form/sections/general/items/body/unit_price.html.twig, plus the tier applied and the next one. #}
{% import '@SyliusShop/shared/macro/money.html.twig' as money %}

{% set item = hookable_metadata.context.item %}
{% set original_price_to_display = sylius_order_item_original_price_to_display(item) %}
{% set tier = tmonier_tier_pricing_item_tier(item) %}
{% set table = tmonier_tier_pricing_cart_table(item) %}

<td class="text-black-50 text-end">
    {% if original_price_to_display is not null %}
        <span {{ sylius_test_html_attribute('cart-item-unit-regular-price') }}>
            <del>{{ money.convertAndFormat(original_price_to_display) }}</del>
        </span>
    {% endif %}
    <span {{ sylius_test_html_attribute('cart-item-unit-price') }}>
        {{ money.convertAndFormat(item.discountedUnitPrice) }}
    </span>
    {% if tier is not null %}
        <div class="small text-success" {{ sylius_test_html_attribute('tmonier-tier-applied') }}>
            {{ 'tmonier_tier_pricing.ui.tier_applied'|trans({'%quantity%': tier.minQuantity|default('')}) }}{% if tier.mixAndMatch|default(false) %} *{% endif %}
        </div>
    {% endif %}
    {% if table is not null and table.nudge is not null %}
        {# Same tax convention as the unit price of the cell (as stored), labelled when known. #}
        {% set tax_convention = tmonier_tier_pricing_tax_convention(item.variant) %}
        {% set tax_suffix = tax_convention is null ? '' : ' ' ~ ((tax_convention == 'included' ? 'tmonier_tier_pricing.ui.incl_tax' : 'tmonier_tier_pricing.ui.excl_tax')|trans) %}
        <div class="small text-info" {{ sylius_test_html_attribute('tmonier-tier-nudge') }}>
            {{ 'tmonier_tier_pricing.ui.nudge'|trans({
                '%quantity%': table.nudge.quantityToAdd,
                '%price%': money.convertAndFormat(table.nudge.unitPrice) ~ tax_suffix,
            }) }}
        </div>
    {% endif %}
</td>
