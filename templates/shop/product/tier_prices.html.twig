{#
    Child of the add to cart form (AddToCartFormComponent): re-rendered when the variant changes.
    Tiers are conditional prices ("from N pieces"), not price reductions: no struck-through price,
    and the "-x %" column only where enabled (off by default in consumer channels). Amounts are
    shown as stored, in the same tax convention as the Sylius price above, with its label.
#}
{% import '@SyliusShop/shared/macro/money.html.twig' as money %}

{% set form = hookable_metadata.context.form %}
{% set variant = form.vars.value.cartItem.variant|default(null) %}
{% set table = tmonier_tier_pricing_table(variant) %}

{% if table is not null %}
    {% set shows_percentage = tmonier_tier_pricing_shows_percentage() %}
    {% set tax_convention = tmonier_tier_pricing_tax_convention(variant) %}
    <div class="mb-4" {{ sylius_test_html_attribute('tmonier-tier-prices') }}>
        <div class="fw-semibold mb-2">{{ 'tmonier_tier_pricing.ui.volume_prices'|trans }}</div>
        <table class="table table-sm align-middle mb-1">
            <thead>
                <tr>
                    <th>{{ 'sylius.ui.quantity'|trans }}</th>
                    <th class="text-end">{{ 'tmonier_tier_pricing.ui.unit_price'|trans }}</th>
                    {% if shows_percentage %}<th class="text-end">{{ 'tmonier_tier_pricing.ui.saving'|trans }}</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for row in table.rows %}
                    {% set active = table.currentUnitPrice is not null and table.currentUnitPrice == row.unitPrice %}
                    <tr {{ sylius_test_html_attribute('tmonier-tier-row', row.minQuantity) }} {% if active %}class="table-active"{% endif %}>
                        <td>
                            {% if loop.first %}
                                {{ 'tmonier_tier_pricing.ui.from_one'|trans }}
                            {% else %}
                                {{ 'tmonier_tier_pricing.ui.from_quantity'|trans({'%quantity%': row.minQuantity}) }}{% if row.mixAndMatch %} *{% endif %}{% if row.taxonBasis %} **{% endif %}
                            {% endif %}
                        </td>
                        <td class="text-end fw-semibold" {{ sylius_test_html_attribute('tmonier-tier-price') }}>
                            {{ money.convertAndFormat(row.unitPrice) }}
                        </td>
                        {% if shows_percentage %}
                            <td class="text-end text-secondary">{% if not loop.first %}-{{ row.percentage }} %{% endif %}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="small text-secondary">
            {% if tax_convention is not null %}
                <span {{ sylius_test_html_attribute('tmonier-tier-tax-label') }}>{{ (tax_convention == 'included' ? 'tmonier_tier_pricing.ui.prices_incl_tax' : 'tmonier_tier_pricing.ui.prices_excl_tax')|trans }}</span>
            {% endif %}
            {% if table.hasMixAndMatch %}<br>* {{ 'tmonier_tier_pricing.ui.mix_and_match'|trans }}{% endif %}
            {% if table.hasTaxonBasis %}<br><span {{ sylius_test_html_attribute('tmonier-tier-taxon-basis') }}>** {{ 'tmonier_tier_pricing.ui.taxon_basis'|trans }}</span>{% endif %}
        </div>
        {% if table.nudge is not null %}
            <div class="alert alert-info py-2 mt-2 mb-0 small" {{ sylius_test_html_attribute('tmonier-tier-nudge') }}>
                {{ 'tmonier_tier_pricing.ui.nudge'|trans({
                    '%quantity%': table.nudge.quantityToAdd,
                    '%price%': money.convertAndFormat(table.nudge.unitPrice),
                }) }}
            </div>
        {% endif %}
    </div>
{% endif %}
